From db1c6fed257b60ff1a0a78c8b0ea45c35d2f2e68 Mon Sep 17 00:00:00 2001
From: ashallowperson <245951141+ashallowperson@users.noreply.github.com>
Date: Fri, 4 Sep 2026 19:20:00 +0500
Subject: [PATCH] FingerprintAuthentication: raise doze screen state for off-screen FOD

Tecno CM6 (MTK6789) uses an optical in-display fingerprint (JIIOV
JV0307). The HAL (anc.hal.so, untouched) does its own touch detection and,
on an off-screen tap, writes lcm_hbm_state=1 and injects FULL_HBM_SET to
light the sensor region. With the device in full screen-off (doze policy,
dozeScreenState=OFF), the kernel rejects that HBM write:

  tran_lcm_hbm_set: display state is slept or idle, skip set hbm node.

so the panel never lights and the first capture is under-exposed
(is_screen_off=1 -> algo match fail 501 -> fid=0). Only a later tap works,
because the panel has by then been brought to DOZE.

Fix: in the framework's FingerprintAuthenticationClient (runs in
system_server), raise the doze SCREEN STATE to Display.STATE_DOZE while the
off-screen authenticate op is active, then restore it when the op ends.
The power policy stays DOZE (the device never wakes to full brightness).
Because the raise happens in startHalOperation(), the panel is already in
DOZE (not "slept/idle") when the HAL's first lcm_hbm_state=1 write lands,
so the very first off-screen tap captures lit (is_screen_off=0) and
authenticates.

Restore is terminal and idempotent: stopHalOperation, onAuthenticated,
onError, finger-up acquired code and onPointerUp all restore the override,
so no stuck-HBM / stuck-display state is left behind.
---
 .../sensors/fingerprint/aidl/FingerprintAuthenticationClient.java  | 83 ++++++++++++++++++++++
 1 file changed, 83 insertions(+)

diff --git a/services/core/java/com/android/server/biometrics/sensors/fingerprint/aidl/FingerprintAuthenticationClient.java b/services/core/java/com/android/server/biometrics/sensors/fingerprint/aidl/FingerprintAuthenticationClient.java
index 51fc0b3e0..90ccc1ed2 100644
--- a/services/core/java/com/android/server/biometrics/sensors/fingerprint/aidl/FingerprintAuthenticationClient.java
+++ b/services/core/java/com/android/server/biometrics/sensors/fingerprint/aidl/FingerprintAuthenticationClient.java
@@ -45,9 +45,13 @@ import android.hardware.fingerprint.FingerprintManager;
 import android.hardware.fingerprint.FingerprintSensorPropertiesInternal;
 import android.hardware.fingerprint.IUdfpsOverlayController;
 import android.os.IBinder;
+import android.os.PowerManager;
+import android.os.PowerManagerInternal;
 import android.os.RemoteException;
 import android.util.Slog;
+import android.view.Display;
 
+import com.android.server.LocalServices;
 import com.android.server.biometrics.log.BiometricContext;
 import com.android.server.biometrics.log.BiometricLogger;
 import com.android.server.biometrics.log.CallbackWithProbe;
@@ -78,6 +82,19 @@ public class FingerprintAuthenticationClient
         extends AuthenticationClient<AidlSession, FingerprintAuthenticateOptions>
         implements Udfps, LockoutConsumer, PowerPressHandler {
     private static final String TAG = "FingerprintAuthenticationClient";
+    // While the panel is in full screen-off (doze policy + dozeScreenState=OFF), the nt37703a
+    // backlight HBM write (lcm_hbm_state=1) made by the HAL is ignored by the panel, so off-screen
+    // optical FOD captures use ambient light and always fail. Raising the doze SCREEN STATE (keeping
+    // policy=DOZE so the device never wakes to full brightness) for the duration of the op lets the
+    // HBM backlight actually light, then we restore it when the op ends.
+    private static final int OFFSCREEN_FOD_DOZE_SCREEN_STATE = Display.STATE_DOZE;
+    // Vendor acquired codes from the JIIOV HAL, observed as legacy 1002 (finger down) and 1003
+    // (finger up) in logcat. Framework converts them to acquiredInfo=6 (VENDOR) + vendorCode.
+    private static final int LEGACY_ACQUIRED_FINGER_DOWN_VENDOR_CODE = 2;
+    private static final int LEGACY_ACQUIRED_FINGER_UP_VENDOR_CODE = 3;
+    @Nullable
+    private PowerManagerInternal mPowerManagerInternal;
+    private boolean mOffscreenFodStateRaised;
     @NonNull
     private final SensorOverlays mSensorOverlays;
     @NonNull
@@ -179,6 +196,7 @@ public class FingerprintAuthenticationClient
         super.onAuthenticated(identifier, authenticated, token);
         handleLockout(authenticated);
         if (authenticated) {
+            restoreOffscreenFodDisplayState();
             mState = STATE_STOPPED;
             mSensorOverlays.hide(getSensorId());
             mAuthenticationStateListeners.onAuthenticationSucceeded(
@@ -249,6 +267,17 @@ public class FingerprintAuthenticationClient
         // For UDFPS, notify SysUI with acquiredInfo, so that the illumination can be turned off
         // for most ACQUIRED messages. See BiometricFingerprintConstants#FingerprintAcquired
         mSensorOverlays.ifUdfps(controller -> controller.onAcquired(getSensorId(), acquiredInfo));
+        // Off-screen FOD: the HAL does its own touch detection (legacy acquired 1002 on finger
+        // down, 1003 on finger up) and there is NO framework onPointerDown/onPointerUp in that
+        // flow (confirmed via logcat). Raise the doze screen state at finger-down so the panel HBM
+        // backlight actually lights during the capture, and restore it at finger-up / op-end.
+        if (acquiredInfo == BiometricFingerprintConstants.FINGERPRINT_ACQUIRED_VENDOR
+                && vendorCode == LEGACY_ACQUIRED_FINGER_DOWN_VENDOR_CODE) {
+            raiseOffscreenFodDisplayState();
+        } else if (acquiredInfo == BiometricFingerprintConstants.FINGERPRINT_ACQUIRED_VENDOR
+                && vendorCode == LEGACY_ACQUIRED_FINGER_UP_VENDOR_CODE) {
+            restoreOffscreenFodDisplayState();
+        }
         super.onAcquired(acquiredInfo, vendorCode);
         PerformanceTracker pt = PerformanceTracker.getInstanceForSensorId(getSensorId());
         pt.incrementAcquireForUser(getTargetUserId(), isCryptoOperation());
@@ -256,6 +285,7 @@ public class FingerprintAuthenticationClient
 
     @Override
     public void onError(int errorCode, int vendorCode) {
+        restoreOffscreenFodDisplayState();
         mAuthenticationStateListeners.onAuthenticationError(
                 new AuthenticationErrorInfo.Builder(BiometricSourceType.FINGERPRINT,
                         getRequestReason(), getErrorString(getContext(), errorCode, vendorCode),
@@ -275,6 +305,12 @@ public class FingerprintAuthenticationClient
 
     @Override
     protected void startHalOperation() {
+        // Raise the doze screen state to DOZE as soon as the (off-screen) op starts, BEFORE the
+        // finger lands, so the panel is already in DOZE (not "slept/idle") when the HAL's first
+        // lcm_hbm_state=1 write arrives. Otherwise the kernel skips the HBM set on a freshly
+        // screen-off panel and the first tap captures dark (is_screen_off=1 -> algo fail).
+        // No-op when the device is awake. Restored in stopHalOperation/onAuthenticated/onError.
+        raiseOffscreenFodDisplayState();
         mSensorOverlays.show(getSensorId(), getRequestReason(), this);
         mAuthenticationStateListeners.onAuthenticationStarted(new AuthenticationStartedInfo
                 .Builder(BiometricSourceType.FINGERPRINT, getRequestReason()).build()
@@ -337,6 +373,7 @@ public class FingerprintAuthenticationClient
 
     @Override
     protected void stopHalOperation() {
+        restoreOffscreenFodDisplayState();
         mSensorOverlays.hide(getSensorId());
         mAuthenticationStateListeners.onAuthenticationStopped(new AuthenticationStoppedInfo
                 .Builder(BiometricSourceType.FINGERPRINT, getRequestReason()).build()
@@ -359,11 +396,66 @@ public class FingerprintAuthenticationClient
         }
     }
 
+    private PowerManagerInternal getPowerManagerInternal() {
+        if (mPowerManagerInternal == null) {
+            mPowerManagerInternal = LocalServices.getService(PowerManagerInternal.class);
+        }
+        return mPowerManagerInternal;
+    }
+
+    /**
+     * While the device is NOT awake (doze / screen-off), raise the doze screen state so the HAL's
+     * HBM backlight write actually lights the sensor area. No-op when the device is awake or the
+     * state is already raised. Never changes the power policy, so the device never wakes to full
+     * brightness (the user asked for screen-ON-less off-screen FOD).
+     */
+    private void raiseOffscreenFodDisplayState() {
+        final PowerManagerInternal pmi = getPowerManagerInternal();
+        if (pmi == null) {
+            return;
+        }
+        final boolean isAwake = getBiometricContext().isAwake();
+        if (mOffscreenFodStateRaised || isAwake) {
+            return;
+        }
+        Slog.i(TAG, "off-screen FOD: raising doze screen state to "
+                + Display.stateToString(OFFSCREEN_FOD_DOZE_SCREEN_STATE));
+        mOffscreenFodStateRaised = true;
+        pmi.setDozeOverrideFromDreamManager(
+                OFFSCREEN_FOD_DOZE_SCREEN_STATE,
+                Display.STATE_REASON_DREAM_MANAGER,
+                PowerManager.BRIGHTNESS_INVALID_FLOAT,
+                false /* useNormalBrightnessForDoze */);
+    }
+
+    /**
+     * Restore the doze screen state override so the panel returns to normal screen-off. Safe to call
+     * multiple times.
+     */
+    private void restoreOffscreenFodDisplayState() {
+        if (!mOffscreenFodStateRaised) {
+            return;
+        }
+        final PowerManagerInternal pmi = getPowerManagerInternal();
+        if (pmi == null) {
+            mOffscreenFodStateRaised = false;
+            return;
+        }
+        Slog.i(TAG, "off-screen FOD: restoring doze screen state");
+        mOffscreenFodStateRaised = false;
+        pmi.setDozeOverrideFromDreamManager(
+                Display.STATE_UNKNOWN,
+                Display.STATE_REASON_UNKNOWN,
+                PowerManager.BRIGHTNESS_INVALID_FLOAT,
+                false /* useNormalBrightnessForDoze */);
+    }
+
     @Override
     public void onPointerDown(PointerContext pc) {
         try {
             mIsPointerDown = true;
             mState = STATE_STARTED;
+            raiseOffscreenFodDisplayState();
 
             final AidlSession session = getFreshDaemon();
             if (session.hasContextMethods()) {
@@ -393,6 +485,7 @@ public class FingerprintAuthenticationClient
             }
 
             getListener().onUdfpsPointerUp(getSensorId());
+            restoreOffscreenFodDisplayState();
         } catch (RemoteException e) {
             Slog.e(TAG, "Remote exception", e);
         }
-- 
