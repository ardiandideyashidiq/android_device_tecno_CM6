# Audio
ro.vendor.audio.number_of_mic=2
ro.vendor.audio.number_of_speaker=2
ro.vendor.tr_audio.typec.support=yes
persist.vendor.audio.usb.offload=false
ro.vendor.audio.us.proximity=true
ro.vendor.tran.midtest.ultrasound_proximity=1
ro.tr_audio.ultrasound.support=1
ro.odm.tr_audio.midtest_ultrasound.support=1
persist.vendor.audio.tuning.def_path=odm/etc/vconfig/audio/audio_param/.
ro.vendor.tran_audio_wireless_microphone.support=1

# Bluetooth
ro.bluetooth.a2dp_offload.supported=false
persist.bluetooth.a2dp_offload.disabled=true

