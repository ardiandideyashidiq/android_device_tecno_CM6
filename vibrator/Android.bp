cc_binary {
    name: "android.hardware.vibrator-service.cm6",
    vintf_fragments: ["android.hardware.vibrator.cm6.xml"],
    init_rc: ["android.hardware.vibrator-service.cm6.rc"],
    vendor: true,
    relative_install_path: "hw",
    srcs: [
        "Vibrator.cpp",
        "VibratorUtils.cpp",
        "main.cpp",
    ],
    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "android.hardware.vibrator-V4-ndk",
    ],
}